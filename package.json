    "@vitejs/plugin-react": "^6.1.2",
    "firebase": "12.19.0",
    "vite": "8.3.4"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
