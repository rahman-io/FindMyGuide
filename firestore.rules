rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function membership(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }
    function isOrgManager(orgId) {
      return signedIn() && exists(membership(orgId)) &&
        get(membership(orgId)).data.active == true &&
        get(membership(orgId)).data.roles.hasAny(['owner', 'manager']);
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['displayName', 'currency', 'language', 'createdAt', 'updatedAt']) &&
        request.resource.data.displayName is string &&
        request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'currency', 'language', 'updatedAt']) &&
        request.resource.data.displayName is string;
      allow delete: if false;

      match /wishlists/{experienceId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) &&
          request.resource.data.keys().hasOnly(['experienceId', 'createdAt']) &&
          request.resource.data.experienceId == experienceId &&
          request.resource.data.createdAt == request.time;
        allow delete: if isSelf(uid);
        allow update: if false;
      }

      match /messages/{messageId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /recommendationEvents/{eventId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) &&
          request.resource.data.keys().hasOnly(['id', 'userId', 'type', 'experienceId', 'city', 'label', 'price', 'duration', 'createdAt', 'schemaVersion']) &&
          request.resource.data.id == eventId &&
          request.resource.data.userId == uid &&
          request.resource.data.type in ['view', 'search', 'wishlist_add', 'wishlist_remove', 'social_like', 'social_save', 'social_comment', 'social_post', 'social_booking_open'] &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /socialSaves/{postId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) &&
          request.resource.data.keys().hasOnly(['postId', 'createdAt']) &&
          request.resource.data.postId == postId &&
          request.resource.data.createdAt == request.time;
        allow delete: if isSelf(uid);
        allow update: if false;
      }
    }

    match /organizations/{orgId} {
      allow read: if resource.data.status == 'published' || isOrgManager(orgId) || isAdmin();
      allow write: if isAdmin();

      match /members/{uid} {
        allow get: if isSelf(uid) || isOrgManager(orgId) || isAdmin();
        allow list: if isOrgManager(orgId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /experiences/{experienceId} {
      allow read: if resource.data.status == 'published' ||
        isOrgManager(resource.data.organizationId) ||
        (signedIn() && request.auth.uid in resource.data.guideIds) || isAdmin();
      allow write: if isAdmin();

      match /slots/{slotId} {
        allow read: if get(/databases/$(database)/documents/experiences/$(experienceId)).data.status == 'published' || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow read: if isSelf(resource.data.userId) || isOrgManager(resource.data.organizationId) || isAdmin();
      allow write: if isAdmin();
    }

    match /guideAssignments/{assignmentId} {
      allow read: if isSelf(resource.data.guideId) || isOrgManager(resource.data.organizationId) || isAdmin();
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isSelf(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if resource.data.status == 'published' || isOrgManager(resource.data.organizationId) || isAdmin();
      allow write: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /attractions/{attractionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /socialProfiles/{uid} {
      allow read: if true;
      allow create: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['id', 'username', 'displayName', 'bio', 'location', 'initials', 'color', 'role', 'schemaVersion', 'createdAt', 'updatedAt']) &&
        request.resource.data.id == uid &&
        request.resource.data.role == 'traveler' &&
        request.resource.data.username is string &&
        request.resource.data.displayName is string &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'displayName', 'bio', 'location', 'initials', 'color', 'updatedAt']));
      allow delete: if isAdmin();

      match /followers/{followerId} {
        allow read: if true;
        allow create: if isSelf(followerId) && uid != followerId &&
          request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt']) &&
          request.resource.data.followerId == followerId &&
          request.resource.data.followingId == uid &&
          request.resource.data.createdAt == request.time;
        allow delete: if isSelf(followerId);
        allow update: if false;
      }
    }

    match /socialPosts/{postId} {
      allow read: if resource.data.status == 'published' || isSelf(resource.data.authorId) || isAdmin();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['id', 'authorId', 'schemaVersion', 'status', 'caption', 'location', 'media', 'experienceId', 'createdAt', 'updatedAt']) &&
        request.resource.data.id == postId &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.status == 'published' &&
        request.resource.data.caption is string &&
        request.resource.data.caption.size() <= 2200 &&
        request.resource.data.media.storagePath is string &&
        request.resource.data.media.storagePath.matches('public/social/' + request.auth.uid + '/[^/]+') &&
        request.resource.data.media.needsUpload == false &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (isSelf(resource.data.authorId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'location', 'updatedAt']) &&
        request.resource.data.caption is string &&
        request.resource.data.caption.size() <= 2200);
      allow delete: if isSelf(resource.data.authorId) || isAdmin();

      match /likes/{uid} {
        allow read: if get(/databases/$(database)/documents/socialPosts/$(postId)).data.status == 'published';
        allow create: if isSelf(uid) &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.status == 'published' &&
          request.resource.data.keys().hasOnly(['userId', 'createdAt']) &&
          request.resource.data.userId == uid &&
          request.resource.data.createdAt == request.time;
        allow delete: if isSelf(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/socialPosts/$(postId)).data.status == 'published' || isAdmin();
        allow create: if signedIn() &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.status == 'published' &&
          request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt', 'updatedAt']) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 500 &&
          request.resource.data.createdAt == request.time;
        allow update: if isAdmin() || (isSelf(resource.data.authorId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 500);
        allow delete: if isSelf(resource.data.authorId) || isAdmin();
      }
    }

    match /socialReports/{reportId} {
      allow get: if isSelf(resource.data.reporterId) || isAdmin();
      allow list: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['postId', 'reporterId', 'reason', 'status', 'createdAt']) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participantIds);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['id', 'schemaVersion', 'participantIds', 'context', 'status', 'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessagePreview']) &&
        request.resource.data.id == conversationId &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() >= 2 &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessageAt', 'lastMessagePreview'])
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function conversationParticipant() {
          return signedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }
        allow read: if isAdmin() || conversationParticipant();
        allow create: if isAdmin() || (
          conversationParticipant() &&
          request.resource.data.keys().hasOnly(['id', 'conversationId', 'senderId', 'text', 'createdAt', 'readBy']) &&
          request.resource.data.id == messageId &&
          request.resource.data.conversationId == conversationId &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.readBy is list
        );
        allow update: if isAdmin() || (
          conversationParticipant() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy is list
        );
        allow delete: if isAdmin();
      }
    }
  }
}
